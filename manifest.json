{
  "manifest_version": 3,
  "name": "VietReader - Đọc văn bản",
  "version": "1.0.0",
  "description": "Chuyển văn bản thành giọng đọc cho tiếng Việt và 9 ngôn ngữ phổ biến khác.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://translate.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "VietReader - Đọc văn bản",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
